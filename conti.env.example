# Copy this file to `conti.env` (which is gitignored) and fill in the values.
# Then run the server with the env loaded:
#   set -a; source conti.env; set +a
#   node dist/cli.js --http --port 3333

# Turso database URL — from:  turso db show conti --url
CONTI_DB=libsql://conti-<you>.turso.io

# Turso auth token — from:  turso db tokens create conti   (keep this secret)
CONTI_DB_AUTH_TOKEN=

# MCP connector secret for the /mcp/<token> link (self-host / testers) —
# generate with:  node dist/cli.js --new-token
CONTI_TOKEN=

# ---------------------------------------------------------------------------
# Hosted mode (OAuth) — optional. One address for everyone, each user isolated
# by their login, no secret link to share. Set these to delegate identity to an
# external Authorization Server (an IdP) and qualify for the connector directory.
# The secret link above keeps working alongside it (for you + testers).
#
# The IdP's issuer URL (must expose /.well-known/openid-configuration + JWKS):
# CONTI_OAUTH_ISSUER=https://your-tenant.your-idp.com
# This server's public https URL (used as the OAuth resource identifier):
# CONTI_PUBLIC_URL=https://conti.example.com
# Expected access-token audience (defaults to <CONTI_PUBLIC_URL>/mcp):
# CONTI_OAUTH_AUDIENCE=
# Browser Origins to allow (comma-separated hostnames), for extra CSRF safety:
# CONTI_ALLOWED_ORIGINS=
