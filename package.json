{
  "name": "conti-mcp",
  "version": "0.2.0",
  "description": "Open-source household finance MCP App: net worth, monthly savings, budget and home-purchase scenarios, rendered inline in Claude and any MCP Apps host. Your data stays yours.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "conti-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "mcp-app",
    "model-context-protocol",
    "personal-finance",
    "budget",
    "net-worth",
    "claude",
    "mortgage",
    "financial-literacy"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --no-warnings test/*.test.mjs",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli.js --http",
    "preview": "node scripts/build.mjs && node scripts/dev-host.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario98-hub/mcp_bandito.git"
  },
  "homepage": "https://github.com/mario98-hub/mcp_bandito#readme",
  "bugs": {
    "url": "https://github.com/mario98-hub/mcp_bandito/issues"
  }
}
